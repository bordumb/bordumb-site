---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — bordumb" description="Page not found.">
  <section class="not-found page-shell">
    <p class="eyebrow">404</p>
    <h1>Nothing here.</h1>
    <p>The page could not be found.</p>
    <a class="text-link" href="/">Return home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 65vh;
    padding-top: clamp(6rem, 15vw, 11rem);
  }

  h1 {
    max-width: 55rem;
    margin: 1.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .not-found > p:not(.eyebrow) {
    margin: 2rem 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.2rem;
  }
</style>
