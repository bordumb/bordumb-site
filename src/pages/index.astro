---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { publishedPosts } from "@/utils/content";

const posts = publishedPosts(await getCollection("blog"));
const recent = posts.slice(0, 3);
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-kicker">
      <p class="eyebrow">Identity · Authority · Evidence</p>
      <span>Madrid · UTC+2</span>
    </div>
    <h1 class="display">Subtle systems.<br /><em>Explicit power.</em></h1>
    <div class="hero-bottom">
      <p>
        I build systems that make consequential claims and powers explicit
        enough to inspect, constrain, and verify.
      </p>
      <a class="hero-cta" href="/work">
        <span>Explore the work</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="about page-shell" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">Outside the machine</p>
      <h2 class="section-heading" id="about-title">About me</h2>
    </div>
    <div class="about-copy">
      <p>
        Much of my education has been self-directed: 17 years studying
        Japanese and 10 years teaching myself software and programming,
        alongside a background in economics. Those paths shaped an interest in
        how people express their relation to one another—through markets,
        language, institutions, and trust.
      </p>
      <p>
        Verification can establish what a machine was permitted to do. It
        cannot replace openness, interpretation, or an open heart. The essays
        here move between those worlds without pretending they are the same.
      </p>
    </div>
  </section>

  <section class="thesis page-shell" aria-labelledby="thesis-title">
    <p class="eyebrow">A through-line</p>
    <div>
      <h2 id="thesis-title">Who acted? What could they do? How would we know?</h2>
      <p>
        Identity, authority, software behavior, and proof look like separate
        problems until a system has to answer for itself. My work lives at
        those seams—and my writing follows the human questions underneath:
        trust, judgment, institutions, language, and reciprocity.
      </p>
    </div>
  </section>

  <section class="writing page-shell" aria-labelledby="writing-title">
    <div class="writing-heading">
      <div>
        <p class="eyebrow">Recent writing</p>
        <h2 class="section-heading" id="writing-title">Notes from the boundary.</h2>
      </div>
      <a class="text-link" href="/blog">All writing</a>
    </div>
    <div class="recent-posts">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 4.5rem);
    padding-top: clamp(4rem, 11vh, 8rem);
    padding-bottom: 2.5rem;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(3.5rem, 10vh, 7rem);
  }

  .hero-kicker span {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .display em {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 34rem) auto;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 8vh, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-strong);
  }

  .hero-bottom p {
    margin: 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    line-height: 1.45;
  }

  .hero-cta {
    display: flex;
    min-width: 11rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.74rem;
    font-weight: 650;
    text-decoration: none;
  }

  .thesis,
  .about {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) 1fr;
    gap: 2rem;
    padding-block: clamp(5rem, 12vw, 10rem);
    border-top: 1px solid var(--border);
  }

  .thesis h2 {
    max-width: 58rem;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 6.5vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .thesis div > p {
    max-width: 39rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.18rem;
    line-height: 1.62;
  }

  .section-heading {
    margin-top: 1rem;
  }

  .about-copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .about-copy p {
    margin: 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.58;
  }

  .writing {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .writing-heading {
    display: flex;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 3rem;
  }

  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      padding-bottom: 6rem;
    }

    .hero-bottom,
    .thesis,
    .about {
      grid-template-columns: 1fr;
    }

    .hero-cta {
      width: 100%;
    }

    .about-copy {
      grid-template-columns: 1fr;
    }

    .writing-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
