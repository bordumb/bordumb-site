---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { publishedPosts } from "@/utils/content";

const posts = publishedPosts(await getCollection("blog"));
const recent = posts.slice(0, 3);
---

<BaseLayout>
  <section class="about page-shell" aria-labelledby="about-title">
    <div>
      <h1 class="section-heading" id="about-title">About me</h1>
    </div>
    <div class="about-copy">
      <p>
        Much of my education has been self-directed: 17 years studying
        Japanese and 10 years teaching myself software and programming,
        alongside a background in economics. Those paths shaped an interest in
        how people express their relation to one another—through markets,
        language, institutions, and trust.
      </p>
    </div>
  </section>

  <section class="writing page-shell" aria-labelledby="writing-title">
    <div class="writing-heading">
      <div>
        <p class="eyebrow">Recent writing</p>
        <h2 class="section-heading" id="writing-title">Notes from the boundary.</h2>
      </div>
      <a class="text-link" href="/blog">All writing</a>
    </div>
    <div class="recent-posts">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) 1fr;
    gap: 2rem;
    padding-block: clamp(5rem, 12vw, 10rem);
    border-top: 1px solid var(--border);
  }

  .section-heading {
    margin-top: 1rem;
  }

  .about-copy {
    max-width: 39rem;
  }

  .about-copy p {
    margin: 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.58;
  }

  .writing {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .writing-heading {
    display: flex;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 3rem;
  }

  @media (max-width: 700px) {
    .about {
      grid-template-columns: 1fr;
    }

    .writing-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
