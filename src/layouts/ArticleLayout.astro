---
import BaseLayout from "./BaseLayout.astro";
import TagList from "@/components/TagList.astro";
import { formatDate, readingTime } from "@/utils/content";

const { frontmatter, body, headings = [] } = Astro.props;
const minutes = readingTime(body ?? "");
const toc = headings.filter((heading: { depth: number }) => heading.depth === 2);
---

<BaseLayout
  title={`${frontmatter.title} — bordumb`}
  description={frontmatter.description}
  article={true}
>
  <article>
    <header class="article-header page-shell">
      <a class="back-link" href="/blog">Writing /</a>
      <h1>{frontmatter.title}</h1>
      <p class="standfirst">{frontmatter.description}</p>
      <div class="article-meta">
        <time datetime={frontmatter.publishedAt.toISOString()}>{formatDate(frontmatter.publishedAt)}</time>
        <span>{minutes} min read</span>
        <TagList tags={frontmatter.tags} />
      </div>
    </header>
    {toc.length >= 3 && (
      <nav class="toc page-shell" aria-label="Table of contents">
        <p>On this page</p>
        <ol>
          {toc.map((heading: { slug: string; text: string }) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose article-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    max-width: 70rem;
    padding-top: clamp(4.5rem, 12vw, 9rem);
  }

  .back-link {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  h1 {
    max-width: 66rem;
    margin: 1.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(3.2rem, 9vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .standfirst {
    max-width: 44rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.5vw, 1.55rem);
    line-height: 1.52;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.2rem;
    align-items: center;
    margin-top: 2rem;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .toc {
    display: grid;
    grid-template-columns: 8rem 1fr;
    max-width: 70rem;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .toc p {
    margin: 0;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
  }

  .article-body {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  @media (max-width: 640px) {
    .toc {
      display: block;
    }

    .toc ol {
      margin-top: 0.8rem;
      flex-direction: column;
    }
  }
</style>
