---
const { label = "Note", tone = "note" } = Astro.props;
---

<aside class="callout" data-tone={tone}>
  <p class="callout-label">{label}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 2.4rem 0;
    padding: 1.15rem 1.25rem 1.15rem 1.4rem;
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 55%, transparent);
    font-family: var(--sans);
  }

  .callout-label {
    margin: 0;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .callout-body {
    margin-top: 0.6rem;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .callout-body :global(p) {
    margin: 0;
  }
</style>
